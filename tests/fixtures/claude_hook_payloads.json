{
 "_comment": "Claude Code PreToolUse tool inputs (documented field names) and the guard action each must normalize to (audit WP17). kind: shell | edit | subagent | none; supported: false marks a tool the adapter does not know.",
 "cases": [
  {"tool_name": "Bash", "tool_input": {"command": "rm -rf ./cache", "description": "clear cache"},
   "expect": {"kind": "shell", "text": "rm -rf ./cache", "files": []}},
  {"tool_name": "PowerShell", "tool_input": {"command": "Remove-Item ./cache -Recurse -Force", "description": "clear cache"},
   "expect": {"kind": "shell", "text": "Remove-Item ./cache -Recurse -Force", "files": []}},
  {"tool_name": "Edit", "tool_input": {"file_path": "src/pricing/cache.py", "old_string": "TTL = 300", "new_string": "TTL = 60"},
   "expect": {"kind": "edit", "text": "edit src/pricing/cache.py: TTL = 60", "files": ["src/pricing/cache.py"]}},
  {"tool_name": "Write", "tool_input": {"file_path": "src/new.py", "content": "print('hi')\n\nprint('there')"},
   "expect": {"kind": "edit", "text": "edit src/new.py: print('hi') print('there')", "files": ["src/new.py"]}},
  {"tool_name": "MultiEdit", "tool_input": {"file_path": "a/b.kt", "edits": [{"old_string": "x", "new_string": "flexTimeInterval"}, {"old_string": "y", "new_string": "z"}]},
   "expect": {"kind": "edit", "text": "edit a/b.kt: flexTimeInterval z", "files": ["a/b.kt"]}},
  {"tool_name": "NotebookEdit", "tool_input": {"notebook_path": "nb/analysis.ipynb", "cell_id": "c1", "new_source": "df = load_prices()", "edit_mode": "replace"},
   "expect": {"kind": "edit", "text": "edit nb/analysis.ipynb: df = load_prices()", "files": ["nb/analysis.ipynb"]}},
  {"tool_name": "NotebookEdit", "tool_input": {"notebook_path": "nb/analysis.ipynb", "cell_type": "code", "new_source": "import pandas", "edit_mode": "insert"},
   "expect": {"kind": "edit", "text": "edit nb/analysis.ipynb: import pandas", "files": ["nb/analysis.ipynb"]}},
  {"tool_name": "NotebookEdit", "tool_input": {"notebook_path": "nb/analysis.ipynb", "cell_id": "c2", "new_source": "", "edit_mode": "delete"},
   "expect": {"kind": "edit", "text": "delete a cell in nb/analysis.ipynb", "files": ["nb/analysis.ipynb"]}},
  {"tool_name": "Task", "tool_input": {"description": "refactor", "prompt": "Rewrite src/auth/session.py to use the new token store", "subagent_type": "general-purpose"},
   "expect": {"kind": "subagent", "text": "Rewrite src/auth/session.py to use the new token store", "files": ["src/auth/session.py"]}},
  {"tool_name": "Agent", "tool_input": {"prompt": "Audit src/billing/webhook.py for double charges"},
   "expect": {"kind": "subagent", "text": "Audit src/billing/webhook.py for double charges", "files": ["src/billing/webhook.py"]}},
  {"tool_name": "Read", "tool_input": {"file_path": "src/pricing/cache.py"},
   "expect": {"kind": "none", "text": "", "files": []}},
  {"tool_name": "Grep", "tool_input": {"pattern": "TTL", "path": "src"},
   "expect": {"kind": "none", "text": "", "files": []}},
  {"tool_name": "WebFetch", "tool_input": {"url": "https://example.invalid", "prompt": "read"},
   "expect": {"kind": "none", "text": "", "files": []}},
  {"tool_name": "mcp__breadcrumbs__memory_jot", "tool_input": {"text": "x"},
   "expect": {"kind": "none", "text": "", "files": [], "supported": false}},
  {"tool_name": "SomeFutureTool", "tool_input": {"command": "rm -rf /"},
   "expect": {"kind": "none", "text": "", "files": [], "supported": false}},
  {"tool_name": "Edit", "tool_input": "not a dict",
   "expect": {"kind": "edit", "text": "edit", "files": []}}
 ]
}
