      "added": 0,
      "date": "2026-09-27",
      "improvements": [
        "webapp::npm test: prompt_delivered no longer missed trap_npm-test-truncates-db",
        "webapp::npm test: ok gained (verdict READ_FIRST)",
        "webapp::npm test: hook_ok gained (verdict READ_FIRST)"
      ],
      "reason": "Audit WP10: an exact command a trap names now floors READ_FIRST (npm test), the prompt hook answers short meaningful prompts and has no 500-record cutoff; the three known F10 critical cases pass and their markers are removed.",
      "regressions": [],
      "removed": []
    },
    {
      "added": 7,
      "date": "2026-10-01",
      "improvements": [],
      "reason": "DoWhat field report (2026-10-01) guard and prompt fixes: compound commands, crumb's own commands and quoted text classified by effect; do-not-retry boost needs topical evidence; template headings and symptom words are not shared words; traps score tags; a lone tag is not a verdict floor; the android suite from the field cases is added (its packet rejects are the resume packet's recency floor)",
      "regressions": [],
      "removed": []
    },
    {
      "added": 5,
      "date": "2026-10-02",
      "improvements": [],
      "reason": "DoWhat retest of 0.5.0: the android suite gains the retest's records and 5 tasks (crumb pipelines, sed, crumb migrate, the 429 and todos attempts); no existing task's metrics changed",
      "regressions": [],
      "removed": []
    },
    {
      "added": 1,
      "date": "2026-10-02",
      "improvements": [],
      "reason": "DoWhat retest of 0.5.0: the android sed task now greps the migration test's name (as in the field) instead of 'migrat(e|ion)', and the hunk attempt mentions git status; both critical cases fail on 0.5.0 and pass now. The only 'regression' is the renamed task.",
      "regressions": [
        "android::sed -n '867p' app/lint-results.txt | grep -oiE 'migrat(e|ion)': task removed"
      ],
      "removed": [
        "android::sed -n '867p' app/lint-results.txt | grep -oiE 'migrat(e|ion)'"
      ]
    }
  ],
  "comment": "Written by `python evals/run.py --write-baseline --reason \u2026`. See evals/README.md.",
  "definitions": {
    "guard": {
      "_system": "cli.guard(task, files): the verdict the library computes",
      "guard_accuracy": {
        "definition": "share of tasks whose verdict is one of those listed",
        "denominator": "tasks that set `verdict`"
      },
      "hook_guard_accuracy": {
        "definition": "share of tasks where `crumb hook guard` delivered a warning exactly when PROCEED is not listed (either is fine when both PROCEED and another verdict are listed); an Edit of `files[0]` when `files` is set, else a Bash command",
        "denominator": "tasks that set `verdict`"
      }
    },
    "packet": {
      "_system": "build_resume_packet(task=\u2026): records the bounded packet kept, re-ranked by task_relevance_scores, zero-score entries dropped; not the reading order",
      "precision_at_5": {
        "definition": "as for prompt, over that re-ranked list",
        "denominator": "tasks with a non-empty `expect`"
      },
      "recall_at_5": {
        "definition": "as for prompt, over that re-ranked list",
        "denominator": "tasks with a non-empty `expect`"
      },
      "reject_hits": {
        "definition": "`reject` ids in a top 5, summed",
        "denominator": "all tasks"
      }
    },
    "packet_delivered": {
      "_system": "`crumb resume --task TASK` as printed: Markdown, headers and warnings included, entries in reading order (the recency floor first)",
      "precision_at_5": {
        "definition": "|first5 \u2229 expect| / |first5|, first5 = the first 5 record entries in reading order, recency-floor entries included",
        "denominator": "tasks with a non-empty `expect`"
      },
      "recall_in_view": {
        "definition": "|delivered \u2229 expect| / |expect| over every record entry in the packet",
        "denominator": "tasks with a non-empty `expect`"
      },
      "reject_hits": {
        "definition": "`reject` ids among the delivered entries, summed",
        "denominator": "all tasks"
      },
      "tokens_max": {
        "definition": "largest approx_tokens of a printed packet",
        "denominator": "all tasks"
      },
      "tokens_mean": {
        "definition": "mean approx_tokens of the printed packet",
        "denominator": "all tasks"
      },
      "within_budget": {
        "definition": "share of packets whose printed text is within the budget its header declares",
        "denominator": "all tasks"
      }
    },
    "prompt": {
      "_system": "hooks_prompt.retrieve(prompt=task): the prompt hook's ranking, before length gating, deduplication and rendering",
      "precision_at_5": {
        "definition": "|top \u2229 expect| / |top|, top = the first 5 returned (fewer if fewer were returned; not divided by 5); 0 when nothing is returned",
        "denominator": "tasks with a non-empty `expect`"
      },
      "quiet": {
        "definition": "share of control tasks where retrieve returned nothing",
        "denominator": "control tasks (`expect: []`)"
      },
      "recall_at_5": {
        "definition": "|top \u2229 expect| / |expect|",
        "denominator": "tasks with a non-empty `expect`"
      },
      "reject_hits": {
        "definition": "`reject` ids in a top 5, summed",
        "denominator": "all tasks"
      }
    },
    "prompt_delivered": {
      "_system": "`crumb hook prompt` run for real (JSON in, JSON out), one fresh session per task: length gating, deduplication and rendering included",
      "dedupe": {
        "definition": "share of tasks the hook spoke on where the same prompt, repeated in the same session, was silent",
        "denominator": "tasks the hook spoke on"
      },
      "precision_at_5": {
        "definition": "|delivered \u2229 expect| / |delivered| over the ids in the injected text, in its order; 0 when silent",
        "denominator": "tasks with a non-empty `expect`"
      },
      "quiet": {
        "definition": "share of control tasks where the hook printed nothing",
        "denominator": "control tasks (`expect: []`)"
      },
      "recall_at_5": {
        "definition": "|delivered \u2229 expect| / |expect|",
        "denominator": "tasks with a non-empty `expect`"
      },
      "reject_hits": {
        "definition": "`reject` ids delivered, summed",
        "denominator": "all tasks"
      },
      "tokens_max": {
        "definition": "largest approx_tokens of an injected text",
        "denominator": "tasks the hook spoke on"
      },
      "tokens_mean": {
        "definition": "mean approx_tokens of the injected text",
        "denominator": "tasks the hook spoke on"
      }
    }
  },
