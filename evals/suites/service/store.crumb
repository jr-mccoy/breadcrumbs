# A Python backend service: auth middleware and a session parser, Postgres with
# a connection pool, Alembic migrations, a Redis rate limiter and Celery
# workers. Exercises what the webapp suite does not: store aliases
# (files/aliases.txt), a stale decision, an expired verification, an answered
# question, and the guard true-positive / false-positive pair fixtures 2 and 3
# pin (a failed auth-middleware rewrite; a pooling refactor nothing objects to).

@2026-02-10 remember decision --title "Session tokens are parsed by src/auth/session_parser.py only"
  --set Context "Three handlers decoded the session cookie themselves and disagreed about expiry."
  --set Decision "Every request goes through src/auth/middleware.py, which calls session_parser.parse(); handlers read request.state.session."
  --set What\ Not\ To\ Retry "Do not decode the cookie in a handler."
  --evidence file src/auth/session_parser.py --evidence file src/auth/middleware.py --tags auth,session

@2026-03-01 remember attempt --title "Rewrote the auth middleware as an ASGI class"
  --set Problem "The middleware function could not short-circuit websocket upgrades."
  --set Tried "A pure ASGI middleware class replacing the Starlette BaseHTTPMiddleware in src/auth/middleware.py."
  --set Result "Background tasks lost the request session and the logout endpoint stopped clearing cookies."
  --set Do\ Not\ Retry\ Unless "Background tasks stop reading request.state."
  --evidence file src/auth/middleware.py --tags auth,middleware

@2026-02-20 remember decision --title "Size the database connection pool per worker process"
  --set Decision "SQLAlchemy pool_size=5, max_overflow=5 per process; 8 processes stay under Postgres max_connections=100."
  --set Rationale "The pool is per process, not per host; the old pool_size=20 exhausted connections under load."
  --evidence file src/db/engine.py --tags db,pool

@2026-03-15 remember attempt --title "Used pgbouncer in transaction mode in front of Postgres"
  --set Problem "Connection exhaustion during deploys."
  --set Tried "pgbouncer transaction pooling."
  --set Result "Prepared statements from asyncpg failed with 'prepared statement does not exist'."
  --set Do\ Not\ Retry\ Unless "statement_cache_size=0 is set on the asyncpg engine."
  --evidence file deploy/pgbouncer.ini --tags db,pool,pgbouncer

@2026-03-05 remember decision --title "Schema changes go through Alembic migrations, never create_all"
  --set Decision "Every schema change is an Alembic revision under migrations/versions; metadata.create_all runs only in tests."
  --evidence file migrations/env.py --tags db,migrations

@2026-04-02 remember attempt --title "Autogenerated a migration that renamed a column"
  --set Problem "Renaming users.name to users.full_name."
  --set Tried "alembic revision --autogenerate."
  --set Result "Autogenerate emitted drop_column plus add_column and the migration deleted every name in staging."
  --set Do\ Not\ Retry\ Unless "The revision is hand-edited to op.alter_column."
  --evidence file migrations/versions/0042_rename_user_name.py --tags db,migrations

@2026-03-22 remember decision --title "Rate limit the public API with a Redis sliding window"
  --set Decision "100 requests per minute per API key, counted in a Redis sorted set per key."
  --evidence file src/api/ratelimit.py --tags api,ratelimit,redis

@2026-01-15 remember decision --title "Send emails synchronously from the request handler"
  --set Decision "Call the SMTP relay inline after signup."
  --evidence file src/email/send.py --tags email

@2026-04-18 remember decision --title "Send emails from a Celery worker"
  --set Context "Inline SMTP calls added two seconds to signup and failed the request when the relay was down."
  --set Decision "Handlers enqueue send_email tasks; the worker retries with backoff."
  --evidence file src/tasks/email.py --tags email,celery,worker
  --supersedes dec_20260115_send-emails-synchronously-from-the-request-handler

@2026-02-01 remember decision --title "Store uploaded avatars on local disk"
  --set Decision "Avatars are written under /var/app/uploads."
  --evidence file src/uploads/avatar.py --tags uploads --status stale

@2026-05-02 remember decision --title "Store uploaded avatars in S3 with presigned URLs"
  --set Decision "Clients upload straight to S3 with a presigned PUT; the API stores only the object key."
  --evidence file src/uploads/avatar.py --tags uploads,s3

@2026-05-20 note trap "Celery tasks run with a stale database session" --slug celery-stale-db-session
  --area "src/tasks/, src/db/session.py"
  --symptom "A task reads a row the request has already updated and sees the old value."
  --why "The task is enqueued before the request transaction commits."
  --safe "Enqueue from transaction.on_commit, never inside the transaction."

@2026-06-01 note trap "Timezone-naive datetimes compare wrong against Postgres timestamptz" --slug naive-datetimes
  --area "src/models/, src/db/"
  --symptom "Subscriptions expire an hour early after the clocks change."
  --why "datetime.utcnow() is naive; asyncpg returns aware datetimes."
  --safe "Use datetime.now(timezone.utc) everywhere."

@2026-06-12 note trap "The rate limiter shares Redis with the Celery broker" --slug ratelimit-redis-shared
  --area "src/api/ratelimit.py, deploy/redis.conf"
  --symptom "A flush of the rate-limit keys also drops queued Celery tasks."
  --why "Both use Redis database 0."
  --safe "Rate limiting uses Redis database 2; never FLUSHDB on database 0."

@2026-08-15 note trap "Logging request bodies leaks passwords" --slug log-request-bodies
  --area "src/api/logging.py"
  --symptom "Plain-text passwords in the log aggregator."
  --why "The debug middleware logs request.json() for every POST, including /login."
  --safe "Log the route and status only; redact bodies at the formatter."

@2026-04-10 verify "Connection pool exhaustion under load test" --status fixed
  --evidence file src/db/engine.py --evidence command "locust -f loadtest/api.py --users 400"

@2026-08-25 verify "Logout clears the session cookie" --status regressed
  --evidence file src/auth/middleware.py --evidence test tests/test_logout.py

@2026-08-01 note question "Should the rate limit be per API key or per account?"

@2026-07-10 note question "Do we keep the pgbouncer config at all?"

@2026-08-20 mark-status q_do-we-keep-the-pgbouncer-config-at-all answered
  --reason "Removed in favour of per-process pools."
